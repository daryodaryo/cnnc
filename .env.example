# For local development only — on Render, DATABASE_URL is injected
# automatically by render.yaml via the linked database.
DATABASE_URL=postgres://user:password@localhost:5432/cnnc
PORT=3000

# Credentials for /admin.html and /api/attempts (HTTP Basic Auth).
# Required — without ADMIN_PASSWORD set, those routes refuse all access.
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-real-password-here
